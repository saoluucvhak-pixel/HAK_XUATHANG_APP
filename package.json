{
  "name": "hak-xuathang-app",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "check": "node tools/check.cjs",
    "quality": "node tools/hak-quality/bin/hak-quality.js app --out reports/quality --fail-on error",
    "release": "node tools/build-release.cjs",
    "lint": "eslint app/js",
    "smoke": "node tools/smoke.cjs",
    "verify": "npm run check && npm run format:check && npm run lint && npm test && npm run smoke",
    "format": "prettier --write \"app/js/**/*.js\" \"tests/*.cjs\" \"tools/*.cjs\" \"tools/hakdb/*.cjs\" \"eslint.config.cjs\"",
    "format:check": "prettier --check \"app/js/**/*.js\" \"tests/*.cjs\" \"tools/*.cjs\" \"tools/hakdb/*.cjs\" \"eslint.config.cjs\"",
    "ui-audit": "node tools/ui-audit.cjs",
    "e2e": "node tools/e2e-flow.cjs",
    "e2e:reports": "node tools/e2e-reports.cjs",
    "e2e:carrier": "node tools/e2e-carrier.cjs",
    "e2e:customs": "node tools/e2e-customs.cjs",
    "e2e:bkls-scope": "node tools/e2e-bkls-scope.cjs",
    "e2e:contract-status": "node tools/e2e-contract-status.cjs",
    "e2e:nonpositive": "node tools/e2e-nonpositive.cjs",
    "e2e:export-parity": "node tools/e2e-export-parity.cjs",
    "e2e:dialogs": "node tools/e2e-dialogs.cjs",
    "e2e:persist-keys": "node tools/e2e-persist-keys.cjs",
    "e2e:bkls-readback": "node tools/e2e-bkls-readback.cjs",
    "e2e:roundtrip": "node tools/e2e-roundtrip.cjs",
    "e2e:month-backup": "node tools/e2e-month-backup.cjs",
    "e2e:backup-ui": "node tools/e2e-backup-ui.cjs",
    "e2e:sf-focus": "node tools/e2e-sf-focus.cjs",
    "e2e:company-scope": "node tools/e2e-company-scope.cjs",
    "e2e:scope-restricted": "node tools/e2e-scope-restricted.cjs",
    "e2e:backup-ui-sqlite": "node tools/e2e-sqlite.cjs tools/e2e-backup-ui.cjs",
    "e2e:sqlite-backup": "node tools/e2e-sqlite.cjs tools/e2e-sqlite-backup.cjs",
    "e2e:roundtrip-cross": "node tools/e2e-roundtrip-cross.cjs",
    "e2e:archive-ops": "node tools/e2e-archive-ops.cjs",
    "e2e:gsync-parity": "node tools/e2e-gsync-parity.cjs",
    "e2e:import-warn": "node tools/e2e-import-warn.cjs",
    "e2e:import-hostile": "node tools/e2e-import-hostile.cjs",
    "e2e:import-hostile-sqlite": "node tools/e2e-sqlite.cjs tools/e2e-import-hostile.cjs",
    "snapshot:customs": "node tools/customs-snapshot.cjs",
    "audit:data": "node tools/data-audit.cjs",
    "accept": "node tools/accept.cjs",
    "accept:release": "node tools/accept.cjs --release"
  },
  "devDependencies": {
    "acorn": "^8.15.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "pdfjs-dist": "4.8.69",
    "prettier": "^3.6.2"
  }
}
